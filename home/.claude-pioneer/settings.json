{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "https://api.pioneer.ai",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "claude-sonnet-5"
  },
  "permissions": {
    "allow": [
      "Bash(cd ~/projects/dotfiles && ./rebuild.sh)",
      "Bash(~/projects/dotfiles/rebuild.sh)"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/enforce-bridge-workflow.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/check-stale-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/fmt-on-edit.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/check-on-edit.sh"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "mattpocock-skills@mattpocock-skills": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "mattpocock-skills": {
      "source": {
        "source": "github",
        "repo": "matt-langston/mattpocock-skills"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "verbose": false,
  "agentPushNotifEnabled": true,
  "_comment": "Pioneer lane store (pio). Self-sufficient: routing lives here, not only in bin/pio-wrapper, so a bare `claude` with CLAUDE_CONFIG_DIR=~/.claude-pioneer still reaches the Pioneer prepaid pool. Key stays in the bridge-secrets Keychain and is read at runtime by apiKeyHelper -- never committed.",
  "apiKeyHelper": "/usr/bin/security find-generic-password -a PIONEER_API_KEY -s bridge-secrets -w"
}
