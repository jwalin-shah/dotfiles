{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "https://api.tokenrouter.com",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek/deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek/deepseek-v4-flash-0731",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi/kimi-k3-free-5.6-luna",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort",
    "OPENAI_GPT_LUNA_MODEL": "openai/gpt-5.6-luna",
    "OPENAI_GPT_LUNA_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort",
    "XAI_GROK_MODEL": "x-ai/grok-4.5",
    "XAI_GROK_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort"
  },
  "permissions": {
    "allow": [
      "Bash(cd ~/projects/dotfiles && ./rebuild.sh)",
      "Bash(~/projects/dotfiles/rebuild.sh)"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/enforce-bridge-workflow.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/check-stale-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/fmt-on-edit.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jwalinshah/.dotfiles/bin/check-on-edit.sh"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "mattpocock-skills@mattpocock-skills": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "mattpocock-skills": {
      "source": {
        "source": "github",
        "repo": "matt-langston/mattpocock-skills"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "verbose": false,
  "agentPushNotifEnabled": true,
  "models": [
    {
      "id": "opus",
      "model": "deepseek-v4-pro",
      "display_name": "DeepSeek v4 Pro"
    },
    {
      "id": "sonnet",
      "model": "deepseek-v4-flash-0731",
      "display_name": "DeepSeek v4 Flash 0731"
    },
    {
      "id": "haiku",
      "model": "kimi-k3-free-5.6-luna",
      "display_name": "Kimi K3 Free 5.6 Luna"
    },
    {
      "id": "gpt-5.6-luna",
      "model": "openai/gpt-5.6-luna",
      "display_name": "OpenAI GPT 5.6 Luna"
    },
    {
      "id": "grok-4.5",
      "model": "x-ai/grok-4.5",
      "display_name": "xAI Grok 4.5"
    }
  ],
  "_comment": "TokenRouter lane store (ct). Self-sufficient: routing lives here, not only in bin/ct-wrapper, so a bare `claude` with CLAUDE_CONFIG_DIR=~/.claude-token still reaches TokenRouter. Key stays in the bridge-secrets Keychain and is read at runtime by apiKeyHelper -- never committed.",
  "apiKeyHelper": "/usr/bin/security find-generic-password -a TOKENROUTER_API_KEY -s bridge-secrets -w"
}
