#!/usr/bin/env bash
# Run the LifeOps MCP adapter with the annotation-derived read-only catalog.
set -euo pipefail

worktree="${LIFEOPS_MCP_ROOT:-/Users/jwalinshah/projects/inbox-lifeops-mcp-v0}"
credential_file="${INBOX_SERVER_ENV_FILE:-$HOME/.config/inbox/server.env}"

if [[ ! -r "$credential_file" || ! -O "$credential_file" ]]; then
  echo "Read-only LifeOps MCP requires an owner-readable local credential file." >&2
  exit 1
fi

file_mode="$(/usr/bin/stat -f '%Lp' "$credential_file")"
if (( (8#$file_mode & 077) != 0 )); then
  echo "Read-only LifeOps MCP refuses a credential file readable by group or others." >&2
  exit 1
fi

inbox_token="$(/usr/bin/awk -F= '$1 == "INBOX_SERVER_TOKEN" {sub(/^[^=]*=/, ""); print; exit}' "$credential_file")"
if [[ -z "$inbox_token" ]]; then
  echo "Read-only LifeOps MCP could not load its local server credential." >&2
  exit 1
fi

export INBOX_SERVER_URL="${INBOX_SERVER_URL:-http://127.0.0.1:9849}"
export INBOX_SERVER_TOKEN="$inbox_token"
export LIFEOPS_MCP_PROFILE="read_only"
export LIFEOPS_MCP_TRANSPORT="stdio"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"

cd "$worktree"
exec uv run python lifeops_mcp.py
