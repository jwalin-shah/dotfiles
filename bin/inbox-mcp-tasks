#!/usr/bin/env bash
# Start the narrow, approval-gated Inbox Google Tasks MCP surface.
set -euo pipefail

inbox_root="${INBOX_ROOT:-/Users/jwalinshah/projects/inbox}"
credential_file="${INBOX_SERVER_ENV_FILE:-$HOME/.config/inbox/server.env}"

if [[ ! -r "$credential_file" || ! -O "$credential_file" ]]; then
  echo "Inbox Tasks MCP requires an owner-readable local credential file." >&2
  exit 1
fi

file_mode="$(/usr/bin/stat -f '%Lp' "$credential_file")"
if (( (8#$file_mode & 077) != 0 )); then
  echo "Inbox Tasks MCP refuses a credential file readable by group or others." >&2
  exit 1
fi

inbox_token="$(/usr/bin/awk -F= '$1 == "INBOX_SERVER_TOKEN" {sub(/^[^=]*=/, ""); print; exit}' "$credential_file")"
if [[ -z "$inbox_token" ]]; then
  echo "Inbox Tasks MCP could not load its local server credential." >&2
  exit 1
fi

export INBOX_SERVER_URL="${INBOX_SERVER_URL:-http://127.0.0.1:9849}"
export INBOX_SERVER_TOKEN="$inbox_token"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"

cd "$inbox_root"
exec uv run python inbox_mcp_tasks_stdio.py
