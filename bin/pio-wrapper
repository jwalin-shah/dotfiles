#!/usr/bin/env bash
set -euo pipefail

# pio: Claude Code → Pioneer prepaid pool (api.pioneer.ai).
# Isolated CLAUDE_CONFIG_DIR so this never touches ca OAuth (~/.claude-a)
# or TokenRouter (~/.claude-token). Do not call `claude auth logout`.
#
# Default model: claude-sonnet-5. Override with --model or ticket.model.
# Also available: claude-opus-5, claude-opus-5-fast, pioneer/auto.

source "$HOME/.local/lib/keychain.bash"
keychain_get PIONEER_API_KEY

exec env \
  CLAUDE_CONFIG_DIR="$HOME/.claude-pioneer" \
  ANTHROPIC_API_KEY="$PIONEER_API_KEY" \
  ANTHROPIC_BASE_URL="https://api.pioneer.ai" \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 \
  ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-5" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5" \
  ANTHROPIC_CUSTOM_MODEL_OPTION="claude-sonnet-5" \
  /opt/homebrew/bin/claude "$@"
