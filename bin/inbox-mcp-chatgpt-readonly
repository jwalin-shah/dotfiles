#!/usr/bin/env bash
# Run the curated read-only Inbox MCP app for a future authenticated tunnel.
set -euo pipefail

inbox_root="${INBOX_ROOT:-/Users/jwalinshah/projects/inbox}"
credential_file="${INBOX_SERVER_ENV_FILE:-$HOME/.config/inbox/server.env}"

if [[ ! -r "$credential_file" || ! -O "$credential_file" ]]; then
  echo "Inbox MCP requires an owner-readable local credential file." >&2
  exit 1
fi
file_mode="$(/usr/bin/stat -f '%Lp' "$credential_file")"
if (( (8#$file_mode & 077) != 0 )); then
  echo "Inbox MCP refuses a credential file readable by group or others." >&2
  exit 1
fi
inbox_token="$(/usr/bin/awk -F= '$1 == "INBOX_SERVER_TOKEN" {sub(/^[^=]*=/, ""); print; exit}' "$credential_file")"
if [[ -z "$inbox_token" ]]; then
  echo "Inbox MCP could not load its local server credential." >&2
  exit 1
fi

export INBOX_SERVER_URL="${INBOX_SERVER_URL:-http://127.0.0.1:9849}"
export INBOX_SERVER_TOKEN="$inbox_token"
export INBOX_MCP_TOKEN="${INBOX_MCP_TOKEN:?Set INBOX_MCP_TOKEN in the tunnel environment before exposing this server}"
export INBOX_MCP_PORT="${INBOX_MCP_PORT:-8001}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
cd "$inbox_root"
exec uv run python mcp_server_chatgpt_readonly.py
